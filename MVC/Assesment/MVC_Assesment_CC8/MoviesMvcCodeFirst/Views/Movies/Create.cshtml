@model MoviesMvcCodeFirst.Models.Movie

<h2 class="text-center text-primary mb-4">Add Movie</h2>

<div class="d-flex justify-content-center">
    @using (Html.BeginForm())
    {
        <table class="table table-bordered w-100 shadow-sm">
            <colgroup>
                <col style="width:30%" />
                <col style="width:70%" />
            </colgroup>

            <thead class="bg-primary text-center text-white">
                <tr>
                    <th colspan="2">Movie Details</th>
                </tr>
            </thead>

            <tbody class="align-middle w-50">
                <tr>
                    <td class="fw-bold text-center w-50">Movie Name</td>
                    <td>
                        @Html.TextBoxFor(m => m.MovieName,
                            new { @class = "form-control" })
                    </td>
                </tr>
                <tr>
                    <td class="fw-bold text-center w-50">Director Name</td>
                    <td>
                        @Html.TextBoxFor(m => m.DirectorName,
                            new { @class = "form-control" })
                    </td>
                </tr>
                <tr>
                    <td class="fw-bold text-center w-50">Date Of Release</td>
                    <td>
                        @Html.TextBoxFor(
                            m => m.DateOfRelease,
                            "{0:yyyy-MM-dd}",
                            new { type = "date", @class = "form-control" })
                    </td>
                </tr>
                <tr>
                    <td colspan="2" class="text-center">
                        <input type="submit" value="Save"
                               class="btn btn-primary px-4" />
                        <a href="@Url.Action("Index")"
                           class="btn btn-secondary ms-2">Cancel</a>
                    </td>
                </tr>
            </tbody>
        </table>
    }
</div>
