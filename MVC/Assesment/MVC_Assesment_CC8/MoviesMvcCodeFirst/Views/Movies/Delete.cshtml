@model MoviesMvcCodeFirst.Models.Movie

<h2 class="text-center text-primary mb-4">Delete Movie</h2>

<div class="d-flex justify-content-center">
    <table class="table table-bordered w-75 shadow-sm">
        <thead class="bg-primary text-center text-white">
            <tr>
                <th colspan="2">Confirm Delete</th>
            </tr>
        </thead>
        <tbody class="text-center">
            <tr>
                <td class="fw-bold">Movie Name</td>
                <td>@Model.MovieName</td>
            </tr>
            <tr>
                <td class="fw-bold">Director</td>
                <td>@Model.DirectorName</td>
            </tr>
            <tr>
                <td class="fw-bold">Release Date</td>
                <td>@Model.DateOfRelease.ToShortDateString()</td>
            </tr>
            <tr>
                <td colspan="2">
                    @using (Html.BeginForm())
                    {
                        @Html.HiddenFor(m => m.Mid)
                        <input type="submit" value="Delete" class="btn btn-danger px-4" />
                        <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">Cancel</a>
                    }
                </td>
            </tr>
        </tbody>
    </table>
</div>
