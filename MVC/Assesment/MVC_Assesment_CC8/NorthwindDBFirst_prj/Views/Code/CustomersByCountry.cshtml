@model IEnumerable<NorthwindDBFirst_prj.Models.Customer>

<h2 class="text-center text-primary mb-4">
    Customers List By Country
</h2>

<div class="d-flex justify-content-center">
    @if (!Model.Any())
    {
        <p class="text-danger fw-bold">No customers found.</p>
    }
    else
    {
        <table class="table table-bordered table-striped table-hover w-75 shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Customer ID</th>
                    <th>Company Name</th>
                    <th>City</th>
                    <th>Country</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td>@customer.CustomerID</td>
                        <td>@customer.CompanyName</td>
                        <td>@customer.City</td>
                        <td>@customer.Country</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
